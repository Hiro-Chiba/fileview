# Previews for images, video, PDF, archives, data, and binary files.
Output assets/demo-preview.gif
Source demo/tapes/common.tape
Set PlaybackSpeed 1.3

Type "fv nebula"
Show
Enter
Sleep 1.5s
Type "P"
Sleep 1.5s

# assets: images, SVG source, and a video with its thumbnail
Type "j"
Sleep 1.2s
Type "l"
Sleep 500ms
Type "j"
Sleep 2s
Type "j"
Sleep 1.5s
Type "j"
Sleep 2.5s
Type "j"
Sleep 2s
Type "j"
Sleep 2.5s

# data: logs, archives, CSV, binary, and JSON
Type "jjj"
Sleep 400ms
Type "l"
Sleep 500ms
Type "j"
Sleep 1.5s
Type "j"
Sleep 2s
Type "j"
Sleep 1.5s
Type "j"
Sleep 2s
Type "j"
Sleep 2s
Type "j"
Sleep 1.5s

# docs/design/whitepaper.pdf, page by page
Type "j"
Sleep 300ms
Type "l"
Sleep 400ms
Type "j"
Sleep 300ms
Type "l"
Sleep 400ms
Type "j"
Sleep 2.5s
Type "]"
Sleep 2s
Type "]"
Sleep 2s

Hide
Type "q"
Sleep 200ms
