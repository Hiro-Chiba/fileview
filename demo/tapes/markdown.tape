# Markdown is rendered when the preview pane is wide enough.
Output assets/demo-markdown.gif
Source demo/tapes/common.tape
Set PlaybackSpeed 1.3

Type "fv nebula"
Show
Enter
Sleep 1.5s

# README.md at the bottom of the tree
Type "G"
Sleep 500ms
Type "P"
Sleep 3s

# Focus the preview and scroll
Right
Sleep 500ms
Type "jjjjjjjjjj"
Sleep 2s
Escape
Sleep 500ms

# docs/architecture.md
Type "g"
Sleep 300ms
Type "jjjjj"
Sleep 300ms
Type "l"
Sleep 500ms
Type "jjj"
Sleep 3s

# Fullscreen
Type "o"
Sleep 3.5s
Type "q"
Sleep 800ms

# docs/getting-started.md
Type "j"
Sleep 3s

Hide
Type "q"
Sleep 200ms
